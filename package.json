{
  "name": "onnx-light-viewer",
  "displayName": "ONNX Light Viewer",
  "description": "A lightweight, interactive ONNX graph viewer for VS Code.",
  "version": "0.3.0",
  "publisher": "xadupre",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xadupre/onnx-light-viewer"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "binary": {
    "napi_versions": [
      8
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "onnxLightViewer.showLogs",
        "title": "ONNX Light Viewer: Show Logs"
      },
      {
        "command": "onnxLightViewer.open",
        "title": "ONNX Light Viewer: Open Graph",
        "icon": "media/logo.svg"
      },
      {
        "command": "onnxLightViewer.openFile",
        "title": "Open with ONNX Light Viewer",
        "icon": "media/logo.svg"
      },
      {
        "command": "onnxLightViewer.openPackage",
        "title": "Open ONNX Runtime Package with ONNX Light Viewer",
        "icon": "media/logo.svg"
      },
      {
        "command": "onnxLightViewer.openSymbolicExample",
        "title": "ONNX Light Viewer: Open Symbolic Transformer Example",
        "icon": "media/logo.svg"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "onnxLightViewer.openFile",
          "when": "!explorerResourceIsFolder && resourceFilename =~ /\\.(onnx|onnx\\.enc|ort|ortpackage|zip|pipe-onnx)$/i",
          "group": "navigation"
        },
        {
          "command": "onnxLightViewer.openPackage",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "onnxLightViewer.openFile",
          "when": "false"
        },
        {
          "command": "onnxLightViewer.openPackage",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "onnxLightViewer.graph",
        "displayName": "ONNX Light Viewer",
        "selector": [
          {
            "filenamePattern": "*.onnx"
          },
          {
            "filenamePattern": "*.ort"
          },
          {
            "filenamePattern": "*.ortpackage"
          },
          {
            "filenamePattern": "*.onnx.enc"
          },
          {
            "filenamePattern": "*.pipe-onnx"
          }
        ],
        "priority": "default"
      }
    ],
    "walkthroughs": [
      {
        "id": "onnxLightViewer.welcome",
        "title": "ONNX Light Viewer",
        "description": "Explore your first ONNX graph.",
        "steps": [
          {
            "id": "open",
            "title": "Open the graph explorer",
            "description": "Start with a one-node demo, then open your own ONNX model.\n[Open Graph](command:onnxLightViewer.open)",
            "media": {
              "image": "media/logo.svg",
              "altText": "ONNX Light Viewer connected graph logo"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:native": "node scripts/build-native.cjs",
    "build:webview": "node scripts/build-webview.cjs",
    "compile": "npm run build:webview && npm run build:native && tsc -p .",
    "watch": "tsc -w -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.96.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "cmake-js": "^8.0.0",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "node-addon-api": "^8.9.2",
    "prettier": "^3.6.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "buffer-crc32": "^1.0.0",
    "fast-xml-parser": "^5.3.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
